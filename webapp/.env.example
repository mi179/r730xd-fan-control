WEB_PORT=8088
WEB_BIND_ADDRESS=192.168.5.2
WEB_CONTAINER_MAC=02:73:0d:73:00:01
WEB_COOKIE_SECURE=false
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes

# Last-known address only. IDRAC_MAC is the stable identity when DHCP moves it.
IDRAC_HOST=192.168.5.111
# Required: replace with the physical iDRAC NIC MAC.
IDRAC_MAC=00:00:00:00:00:00
IDRAC_DISCOVERY_CIDR=192.168.5.0/24
IDRAC_ARP_INTERFACE=br-lan
IDRAC_DISCOVERY_SCAN_INTERVAL=60
IDRAC_DISCOVERY_PROBE_TIMEOUT=0.8
IDRAC_USER=root
IDRAC_IPMI_PORT=623
IDRAC_REDFISH_PORT=443
REDFISH_VERIFY_TLS=false
# Strongly recommended. iDRAC uses a self-signed certificate, so CA validation
# cannot be turned on; pinning the leaf certificate is the equivalent control.
# Get the value on the WRT host with:
#   openssl s_client -connect 192.168.5.151:443 </dev/null 2>/dev/null | \
#     openssl x509 -noout -fingerprint -sha256
# Colons are optional; the value is normalised on startup.
REDFISH_TLS_FINGERPRINT=

TELEMETRY_CACHE_TTL=8
TELEMETRY_SAMPLE_INTERVAL=15
HISTORY_MAX_SAMPLES=90

# Durable telemetry history (SQLite on the r730xd-telemetry named volume).
# Set TELEMETRY_DB_PATH empty to go back to memory-only history.
TELEMETRY_DB_PATH=/data/telemetry.db
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_FLUSH_INTERVAL=60
TELEMETRY_FLUSH_THRESHOLD=20

TZ=Asia/Shanghai
